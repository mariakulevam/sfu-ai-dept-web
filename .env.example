# Django
DJANGO_SECRET_KEY=your-secret-key-here-change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# FastAPI бэкенд (модуль команды Риты)
FASTAPI_ROOT_URL=http://127.0.0.1:8001

# Публичный адрес FastAPI для WebSocket из браузера.
# На проде ОБЯЗАТЕЛЬНО задать публичный домен, иначе чат застрянет
# на статусе "Подключение..." — браузер не достучится до 127.0.0.1.
# Пример для прода: https://av-kushnarenko.ru
# (схема https:// автоматически превратится в wss://)
# FASTAPI_PUBLIC_URL=https://av-kushnarenko.ru
